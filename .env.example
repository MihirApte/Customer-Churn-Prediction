# Template for local secrets. This file is safe to commit because it holds no real key.
#
# To use it:
#   1. Copy this file to a new file named .env  (PowerShell: Copy-Item .env.example .env)
#   2. Paste your Groq API key after GROQ_API_KEY=  with no quotes and no spaces
#   3. Never commit .env (it is listed in .gitignore)
#
# On HuggingFace Spaces there is no .env file. Add GROQ_API_KEY as a Space secret instead.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
